  "2-5": {
   "f": "2-5.mp3",
   "t": "ずるいのだ、電圧源!",
   "sig": "[7,{\"speedScale\":1.1550000000000002,\"pitchScale\":0,\"intonationScale\":1.4300000000000002,\"prePhonemeLength\":0.05,\"postPhonemeLength\":0.12}]"
